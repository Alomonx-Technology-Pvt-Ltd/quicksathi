# ════════════════════════════════════════════════════════════════
# QuickSathi Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# The .env file is git-ignored — NEVER commit real secrets.
# ════════════════════════════════════════════════════════════════

# ── MongoDB ──
# ⚠️  Include the database name before '?' to avoid writing to the 'test' DB:
#     mongodb+srv://user:password@cluster.mongodb.net/quicksathi?appName=...
MONGODB_URI=mongodb+srv://your_user:your_password@your-cluster.mongodb.net/quicksathi?appName=Your-Cluster

# ── JWT ──
# Use a long random string in production: openssl rand -hex 64
JWT_SECRET=change_this_to_a_strong_random_secret_in_production
JWT_EXPIRES_IN=7d

# ── Server ──
PORT=5050
# Values: development | production
NODE_ENV=development

# ── Frontend URL (CORS) ──
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Optional — additional comma-separated allowed origins
# ADDITIONAL_ORIGINS=https://your-custom-domain.com,https://staging.yourdomain.com

# ── Admin Credentials ──
# Comma-separated. Users signing in with these emails get admin role automatically.
ADMIN_EMAILS=yourname@gmail.com
# Admin password (enables direct email/password login to /admin with any ADMIN_EMAILS email)
ADMIN_PASSWORD=your_secure_admin_password_here


# ── Firebase Admin SDK ──
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the full private key including -----BEGIN / END PRIVATE KEY----- lines
# Replace actual newlines with \n so it fits on one line in .env
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Cloudinary ──
# Get from: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── SMTP Email (Choose ONE provider below) ──
# Option 1: Gmail SMTP (500 free emails/day, no third-party signup required)
# 1. Enable 2-Step Verification in Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password named "QuickSathi", copy the 16 characters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=quicksathi9@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_SENDER="QuickSathi" <quicksathi9@gmail.com>

# Option 2: Brevo (formerly Sendinblue - 300 free emails/day = 9,000/month free)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login_email
# SMTP_PASS=your_brevo_smtp_key
# SMTP_SENDER="QuickSathi" <support@quicksathi.com>

# Option 3: Resend (100 free emails/day = 3,000/month free, requires custom domain)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_your_resend_api_key
# SMTP_SENDER="QuickSathi" <notifications@quicksathi.com>

# ── Razorpay ──
# Test mode: rzp_test_... | Live mode: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
# Webhook endpoint: POST https://<api-host>/api/payments/webhook  (events: payment.captured, payment.failed, order.paid)
RAZORPAY_WEBHOOK_SECRET=whsec_set_in_razorpay_dashboard

# ── Groq AI API Key ──
# Get from: console.groq.com → API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
