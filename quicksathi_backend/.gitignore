# ── Dependencies ──
node_modules/

# ── Environment variables (NEVER commit secrets) ──
.env
.env.*
!.env.example

# ── Firebase service account (contains private key — NEVER commit) ──
config/firebase-service-account.json

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Build / runtime artifacts ──
dist/
build/

# ── OS artifacts ──
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Editor ──
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Testing & coverage ──
coverage/
*.lcov

# ── Uploaded files (if any local upload dir) ──
uploads/
