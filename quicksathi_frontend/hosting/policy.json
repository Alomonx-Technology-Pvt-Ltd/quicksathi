{
  "$comment": "Single source for every static host (Netlify, Cloudflare Pages, Hostinger/Apache, Vercel). Edit this file, then run `npm run host-config` to regenerate public/_headers, public/.htaccess, netlify.toml and vercel.json. CI fails if they drift.",
  "securityHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(self), camera=(self), microphone=(), payment=(self)",
    "Content-Security-Policy": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
  },
  "cacheControl": {
    "immutable": { "prefix": "/assets/", "value": "public, max-age=31536000, immutable" },
    "html": { "path": "/index.html", "value": "public, max-age=0, must-revalidate" }
  },
  "spaFallback": "/index.html"
}
