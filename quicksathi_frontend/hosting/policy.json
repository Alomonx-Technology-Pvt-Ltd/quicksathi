{
  "$comment": "Single source for every static host (Cloudflare Workers/Pages, Hostinger/Apache, Vercel, Netlify headers). Edit this file, then run `npm run host-config` to regenerate wrangler.jsonc, public/_headers, public/.assetsignore, public/.htaccess and vercel.json. CI fails if they drift.",
  "cloudflare": { "workerName": "tiptobook-frontend", "compatibilityDate": "2026-09-01" },
  "securityHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(self), camera=(self), microphone=(), payment=(self)",
    "Content-Security-Policy": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
  },
  "cacheControl": {
    "immutable": { "prefix": "/assets/", "value": "public, max-age=31536000, immutable" },
    "html": { "path": "/index.html", "value": "public, max-age=0, must-revalidate" }
  },
  "spaFallback": "/index.html"
}
