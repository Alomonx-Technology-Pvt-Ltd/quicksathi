# ── API Configuration ──
# Backend API URL. Change this to your production URL when deploying.
VITE_API_URL=http://localhost:5000/api

# ── Firebase Configuration ──
# Get these from: https://console.firebase.google.com → Project Settings → Web App
# Once you fill these in, Google Sign-In will work immediately!

VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:XXXXXXXXXXXXXXXX
