# ── QuickSathi Monorepo Root .gitignore ──

# ── OS artifacts ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Editor / IDE ──
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Logs ──
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Dependencies ──
node_modules/

# ── Environment files (SECURITY — handled per-subproject too) ──
# NEVER commit real .env files — they contain secrets!
.env
.env.local
.env.production
.env.staging
.env.*.local

# ── Firebase Service Account JSON (contains private key) ──
**/config/firebase-service-account.json

# ── Build output ──
dist/
dist-ssr/
build/

# ── Deploy artifacts (generated, not source) ──
quicksathi_deploy/

# ── Uploaded / generated files ──
uploads/
coverage/
*.lcov
